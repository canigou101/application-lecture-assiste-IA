<mxfile host="65bd71144e">
    <diagram id="4zYvG-wqtowVRcDpEv3O" name="Page-1">
        <mxGraphModel dx="4591" dy="2270" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% ==========================================\n    %% 1. COUCHE PRÉSENTATION (Interfaces / UI)\n    %% Respect du DIP : Dépend uniquement de NarrativeEngine\n    %% ==========================================\n    class IUserInterface {\n        &lt;&lt;interface&gt;&gt;\n        +afficher_scene(contexte: str) void\n        +demander_action() str\n        +afficher_resultat(narration: str, metriques: dict) void\n    }\n\n    class CLIInterface {\n        +afficher_scene(contexte: str) void\n        +demander_action() str\n        +afficher_resultat(narration: str, metriques: dict) void\n    }\n\n    class TkinterInterface {\n        -root: Tk\n        -thread_pool: ThreadPoolExecutor\n        +afficher_scene(contexte: str) void\n        +demander_action() str\n        +afficher_resultat(narration: str, metriques: dict) void\n    }\n\n    IUserInterface &lt;|.. CLIInterface : implémente\n    IUserInterface &lt;|.. TkinterInterface : implémente\n\n    %% ==========================================\n    %% 2. COUCHE DOMAINE &amp; MODÈLES (SRP)\n    %% ==========================================\n    class Scene {\n        +scene_id: str\n        +lieu: str\n        +niveau_danger: int\n        +resume_telegraphique: str\n        +personnages_presents: List~Personnage~\n        +to_json() str\n        +save_to_file(filepath: str) void\n        +from_json(json_str: str)$ Scene\n        +load_from_file(filepath: str)$ Scene\n        +generer_contexte_llm() str\n    }\n\n    class Personnage {\n        +id: str\n        +nom: str\n        +est_joueur: bool\n        +caractere: str\n        +traits_physiques: List~str~\n        +objectif_cache: Optional~str~\n        +stats: Stats\n        +relations: Relations\n    }\n\n    class Stats {\n        +force: int\n        +dext: int\n        +charisme: int\n        +force_mentale: int\n        +discretion: int\n        +chance: int\n        +stat_arme: int\n        +stat_cosmetics: int\n        +stat_magie_potion: int\n    }\n\n    class Relations {\n        +allies: List~str~\n        +ennemis: List~str~\n    }\n\n    Scene \&quot;1\&quot; *-- \&quot;1..*\&quot; Personnage : contient\n    Personnage \&quot;1\&quot; *-- \&quot;1\&quot; Stats : possède\n    Personnage \&quot;1\&quot; *-- \&quot;1\&quot; Relations : entretient\n\n    %% ==========================================\n    %% 3. PERSISTANCE &amp; CONFIGURATION (SRP / ISP)\n    %% ==========================================\n    class ISceneRepository {\n        &lt;&lt;interface&gt;&gt;\n        +charger(source: str) Scene\n        +sauvegarder(scene: Scene, destination: str) void\n    }\n\n    class JsonSceneRepository {\n        -schema_path: str\n        +charger(filepath: str) Scene\n        +sauvegarder(scene: Scene, filepath: str) void\n        -valider_schema(data: dict) bool\n    }\n\n    class SecretsConfig {\n        +openrouter_api_key: str\n        +jetson_ip: str\n        +charger_secrets()$ dict\n    }\n\n    ISceneRepository &lt;|.. JsonSceneRepository : implémente\n    JsonSceneRepository ..&gt; Scene : sérialise / désérialise\n\n    %% ==========================================\n    %% 4. MOTEUR DE RÈGLES &amp; ORCHESTRATEUR (SRP / OCP)\n    %% ==========================================\n    class ActionFilter {\n        -mots_cles_neutres: List~str~\n        +est_action_avec_consequence(action: str) bool\n    }\n\n    class MoteurReglesJDR {\n        +est_action_avec_consequence(action_texte: str) bool\n        +verifier_autorisation_attaque(p1: Personnage, p2: Personnage) Tuple~bool, str~\n        +calculer_est_mon_ennemi(p1: Personnage, p2: Personnage) int\n        +calculer_degats(attaquant: Personnage, cible: Personnage, cote: str, malus: int, jet_de: Optional~int~) dict\n        +calculer_seduction(initiateur: Personnage, cible: Personnage, malus: int, jet_de: Optional~int~) dict\n        +calculer_vol(voleur: Personnage, malus: int, jet_de: Optional~int~) dict\n        +calculer_alteration_mentale(lanceur: Personnage, c1: int, c2: int, jet_de: Optional~int~) dict\n        +evaluer_jet(score_total: float, difficulte: int) ResultatAction\n    }\n\n    class NarrativeEngine {\n        -ui: IUserInterface\n        -repository: ISceneRepository\n        -filter: ActionFilter\n        -rules_engine: MoteurReglesJDR\n        -llm_provider: ILLMProvider\n        -scene_courante: Scene\n        +executer_tour(action_joueur: str) void\n        +changer_scene(nouvelle_scene_id: str) void\n        +basculer_fournisseur(nouveau_provider: ILLMProvider) void\n    }\n\n    NarrativeEngine --&gt; IUserInterface : pilote\n    NarrativeEngine --&gt; ISceneRepository : persiste via\n    NarrativeEngine --&gt; ActionFilter : délègue filtrage\n    NarrativeEngine --&gt; MoteurReglesJDR : délègue règles\n    NarrativeEngine --&gt; Scene : gère état courant\n    NarrativeEngine ..&gt; SecretsConfig : lit configuration\n\n    %% ==========================================\n    %% 5. INFRASTRUCTURE IA — Package src/llm/ (OCP / LSP / DIP)\n    %% ==========================================\n    class ILLMProvider {\n        &lt;&lt;interface&gt;&gt;\n        +generer_narration(prompt: str, num_ctx: int) dict\n    }\n\n    class OllamaProvider {\n        -endpoint: str\n        -modele: str\n        +generer_narration(prompt: str, num_ctx: int) dict\n    }\n\n    class OpenRouterProvider {\n        +ENDPOINT: str$\n        -api_key: str\n        -modele: str\n        -app_name: str\n        +generer_narration(prompt: str, num_ctx: int) dict\n    }\n\n    ILLMProvider &lt;|.. OllamaProvider : implémente (src/llm/ollama_provider.py)\n    ILLMProvider &lt;|.. OpenRouterProvider : implémente (src/llm/openrouter_provider.py)\n    NarrativeEngine --&gt; ILLMProvider : interroge via contrat (src/llm/base_provider.py)\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="UGyOqmiYjq44pkXcsmaG-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
